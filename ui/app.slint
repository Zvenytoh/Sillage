import { Button, AboutSlint } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { PlayerControls } from "player.slint";
import { MusicSearch } from "library.slint";
import { SearchRow } from "model.slint";
export { SearchRow } from "model.slint";

export component AboutWindow inherits Window {
    title: "About Sillage";
    width: 360px;
    height: 240px;
    VerticalLayout {
        padding: 24px;
        Text { text: "Sillage"; font-size: 24px; font-weight: 700; }
        Text { text: "Version 0.1.0 · MIT"; }
        AboutSlint { }
    }
}

export component AppWindow inherits Window {
    title: "Sillage";
    icon: @image-url("../assets/sillage.png");
    preferred-width: 1040px;
    preferred-height: 660px;
    min-width: 800px;
    min-height: 560px;
    background: Theme.paper;
    default-font-family: "Segoe UI";
    in property <string> track-title: "No track selected";
    in property <string> duration-label: "Choose a result to listen.";
    in property <string> status: "Search for music to begin.";
    in-out property <string> query;
    in property <[SearchRow]> results;
    in property <bool> searching;
    in property <bool> searched;
    in property <string> search-error;
    in property <string> error-message;
    in property <bool> loaded;
    in property <bool> playing;
    in property <bool> busy;
    in-out property <float> volume: 25;
    callback open-file();
    callback toggle-play();
    callback stop();
    callback volume-changed(float);
    callback show-about();
    callback query-edited(string);
    callback search();
    callback play-track(SearchRow);

    HorizontalLayout {
        spacing: 0;
        Rectangle {
            width: 208px;
            background: Theme.pine;
            VerticalLayout {
                padding: 28px;
                spacing: 20px;
                Image { source: @image-url("../assets/sillage.png"); width: 60px; height: 60px; }
                Text { text: "Sillage"; color: Theme.paper; font-size: 27px; font-weight: 700; }
                Text { text: "Music in motion."; color: #bfcebf; font-size: 13px; }
                Rectangle { height: 1px; background: #3b5043; }
                Text { text: "YouTube Music"; color: Theme.citron; font-size: 15px; font-weight: 600; }
                Rectangle { vertical-stretch: 1; }
                Button { text: "About Sillage"; clicked => { root.show-about(); } }
            }
        }
        VerticalLayout {
            spacing: 0;
            VerticalLayout {
                padding: 28px;
                spacing: 16px;
                HorizontalLayout {
                    Text { text: "Your music, close at hand."; color: Theme.pine; font-size: 23px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                    Button { text: "Local file…"; enabled: !root.busy; clicked => { root.open-file(); } }
                }
                Rectangle { height: 1px; background: Theme.line; }
                MusicSearch {
                    vertical-stretch: 1;
                    query <=> root.query;
                    results: root.results;
                    searching: root.searching;
                    searched: root.searched;
                    search-error: root.search-error;
                    busy: root.busy;
                    query-edited(text) => { root.query-edited(text); }
                    search => { root.search(); }
                    play-track(row) => { root.play-track(row); }
                }
                Rectangle { height: 1px; background: Theme.line; }
                HorizontalLayout {
                    spacing: 16px;
                    Image { source: @image-url("../assets/sillage.png"); width: 48px; height: 48px; }
                    VerticalLayout {
                        Text { text: root.track-title; color: Theme.pine; font-size: 19px; font-weight: 600; overflow: elide; min-width: 0px; }
                        Text { text: root.duration-label; color: Theme.muted; font-size: 13px; }
                    }
                }
                Text { text: root.error-message; color: Theme.error; font-size: 14px; wrap: word-wrap; visible: root.error-message != ""; }
            }
            PlayerControls {
                height: 128px;
                loaded: root.loaded;
                playing: root.playing;
                busy: root.busy;
                status: root.status;
                volume <=> root.volume;
                toggle-play => { root.toggle-play(); }
                stop => { root.stop(); }
                volume-changed(value) => { root.volume-changed(value); }
            }
        }
    }
}
