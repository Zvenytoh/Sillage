import { Theme } from "theme.slint";

export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <string> label: root.text;
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> selected;
    in property <bool> filled;
    in property <bool> round;
    in property <bool> quiet;
    in property <bool> active;
    in property <bool> accented;
    out property <bool> has-focus: focus.has-focus;
    callback clicked();
    min-width: root.text == "" ? 40px : 96px;
    min-height: 32px;
    preferred-height: 40px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: root.round ? self.height / 2 : 8px;
    background: root.accented ? Theme.accent : root.filled ? (touch.has-hover ? #ffffff : #eeeeee) : touch.has-hover && root.enabled ? Theme.hover : root.selected ? Theme.elevated : root.quiet ? transparent : Theme.elevated;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    opacity: root.enabled ? 1 : 0.35;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    HorizontalLayout {
        padding-left: root.text == "" ? 10px : 14px;
        padding-right: root.text == "" ? 10px : 14px;
        spacing: 12px;
        alignment: root.text == "" ? center : start;
        if root.icon.width > 0: Rectangle {
            width: 20px; horizontal-stretch: 0;
            Image {
                source: root.icon; width: 20px; height: 20px;
                y: (parent.height - self.height) / 2;
                colorize: root.accented ? Theme.accent-ink : root.filled ? Theme.canvas : root.selected || root.active ? Theme.accent : touch.has-hover ? Theme.text : Theme.muted;
            }
        }
        if root.text != "": Text {
            text: root.text; color: root.accented ? Theme.accent-ink : root.filled ? Theme.canvas : root.selected ? Theme.accent : Theme.text;
            font-size: 14px; font-weight: 600; vertical-alignment: center;
        }
    }
    if root.active: Rectangle { width: 4px; height: 4px; border-radius: 2px; background: Theme.text; x: (parent.width - 4px) / 2; y: parent.height - 3px; }
    touch := TouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
    focus := FocusScope {
        width: 0; enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked(); return accept;
            }
            return reject;
        }
    }
}

export component Cover inherits Rectangle {
    in property <image> artwork;
    background: Theme.elevated;
    border-radius: 4px;
    clip: true;
    Image {
        source: root.artwork.width > 0 ? root.artwork : @image-url("../assets/ui/music.svg");
        width: root.artwork.width > 0 ? parent.width : 24px;
        height: root.artwork.width > 0 ? parent.height : 24px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: root.artwork.width > root.artwork.height * 1.3 ? contain : cover;
        colorize: root.artwork.width > 0 ? transparent : Theme.muted;
    }
}

export component SearchField inherits Rectangle {
    in-out property <string> text;
    callback edited(string);
    callback accepted();
    height: 48px;
    border-radius: 24px;
    background: input.has-focus ? #303030 : Theme.elevated;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.text : transparent;
    forward-focus: input;
    HorizontalLayout {
        padding-left: 18px; padding-right: 10px; spacing: 12px;
        Rectangle {
            width: 22px; horizontal-stretch: 0;
            Image { source: @image-url("../assets/ui/search.svg"); width: 22px; height: 22px; y: (parent.height - 22px) / 2; colorize: Theme.muted; }
        }
        Rectangle {
            horizontal-stretch: 1;
            Text {
                text: "Rechercher un titre, un artiste…"; color: Theme.muted;
                font-size: 14px; vertical-alignment: center;
                visible: root.text == "";
            }
            input := TextInput {
                text <=> root.text; color: Theme.text; font-size: 14px;
                single-line: true; vertical-alignment: center;
                selection-background-color: Theme.accent;
                selection-foreground-color: Theme.canvas;
                accessible-label: "Rechercher sur YouTube Music";
                edited => { root.edited(self.text); }
                accepted => { root.accepted(); }
            }
        }
        if root.text != "": ActionButton {
            icon: @image-url("../assets/ui/close.svg"); label: "Effacer la recherche";
            quiet: true; round: true;
            clicked => { root.text = ""; root.edited(""); input.focus(); }
        }
    }
}
