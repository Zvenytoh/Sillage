import { Button, Slider } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component PlayerControls inherits Rectangle {
    in property <bool> loaded;
    in property <bool> playing;
    in property <bool> busy;
    in property <string> status;
    in-out property <float> volume: 25;
    callback toggle-play();
    callback stop();
    callback volume-changed(float);
    background: #e7ebdf;
    VerticalLayout {
        padding: 24px;
        spacing: 14px;
        Text { text: root.status; color: Theme.muted; font-size: 14px; }
        HorizontalLayout {
            spacing: 12px;
            Button { text: root.playing ? "Pause" : "Play"; enabled: root.loaded && !root.busy; clicked => { root.toggle-play(); } }
            Button { text: "Stop"; enabled: root.loaded || root.busy; clicked => { root.stop(); } }
            Rectangle { horizontal-stretch: 1; }
            Text { text: "Volume"; color: Theme.pine; vertical-alignment: center; }
            Slider { width: 150px; minimum: 0; maximum: 100; value <=> root.volume; enabled: !root.busy; accessible-label: "Volume"; changed(value) => { root.volume-changed(value / 100); } }
        }
    }
}
